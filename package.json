{
  "name": "shape-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "mobile"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:mobile": "npm run start --workspace mobile",
    "dev:mobile:lan": "node scripts/start-mobile-lan.cjs",
    "dev:mobile:tunnel": "node scripts/start-mobile-lan.cjs --tunnel",
    "build": "npm run build --workspace shared && npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run lint --workspace shared && npm run build --workspace shared && npm run test --workspace backend && npm run test --workspace frontend",
    "lint": "npm run lint --workspace shared && npm run build --workspace shared && npm run lint --workspace backend && npm run lint --workspace frontend",
    "lint:mobile": "npm run build --workspace shared && npm run lint --workspace mobile",
    "e2e": "node scripts/run-e2e-isolated.cjs",
    "e2e:docker": "node scripts/run-e2e-isolated.cjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "prisma": "7.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "@humanfs/node": "0.16.8",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.19",
    "postcss-selector-parser": "6.1.5",
    "qs": "6.17.1",
    "@expo/fingerprint@0.20.17": {
      "minimatch": "11.0.9"
    },
    "@prisma/config": {
      "effect": "3.22.1"
    }
  },
  "dependencies": {
    "nvm": "^0.0.4"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true
  }
}
